# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sms_analyzer

# Auth. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin allowed to call the API directly.
# The webpack dev server proxies /api, so same-origin dev does not need CORS.
CLIENT_ORIGIN=http://localhost:8080

# Optional OpenAI-compatible chat endpoint. Leave LLM_API_KEY empty to use
# the local heuristic summary. The key is read only on the server.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# How long to wait for the model to start responding. Minimum 60000.
LLM_TIMEOUT_MS=120000

# Upload cap for one SMS export.
UPLOAD_MAX_MB=8
